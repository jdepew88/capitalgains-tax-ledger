{
  "name": "joyces-home-ledger",
  "version": "1.0.0",
  "description": "Home improvement records for a tax preparer",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply joyces-home-ledger --local",
    "db:migrate:remote": "wrangler d1 migrations apply joyces-home-ledger --remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts --include-runtime false"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.154.0"
  },
  "private": true,
  "type": "module"
}
