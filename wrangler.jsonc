{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capitalgains",
  // Served only at https://capitalgains.joeydepew.workers.dev (protected by Cloudflare Access).
  "workers_dev": true,
  // Version preview URLs are off so there is no second, unprotected hostname.
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request (including the HTML/JS) passes through the Worker's auth check first.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "capitalgains-ledger",
      "database_id": "9d11cdf9-2c4d-4774-a75c-69e4ffa0c359",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "capitalgains-ledger-documents"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   ACCESS_TEAM_DOMAIN  e.g. yourteam.cloudflareaccess.com
  //   ACCESS_AUD          the Access application's Audience (AUD) tag
  //   ALLOWED_EMAILS      comma-separated allowlist, e.g. you@example.com,joyce@example.com
}
